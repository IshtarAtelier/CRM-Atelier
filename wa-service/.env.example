# Variables requeridas para wa-service en Railway
DATABASE_URL=postgresql://...your_railway_postgres_url...
GOOGLE_GENAI_API_KEY=your_gemini_api_key
CRM_API_URL=http://crm-service.railway.internal:3000/api/bot
PORT=3100

# ── Transporte ───────────────────────────────────────────────────────────────
# webjs = WhatsApp Web + Chromium (legacy, default) · cloud = API oficial de Meta
WA_TRANSPORT=webjs

# ── API oficial (Cloud API) — solo con WA_TRANSPORT=cloud ─────────────────────
# Token del system user con whatsapp_business_messaging + whatsapp_business_management.
# NUNCA en el repo ni en un chat: se pega directo en Railway.
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_WABA_ID=
# String aleatorio nuestro; se pega igual en la app de Meta al suscribir el webhook.
WA_CLOUD_VERIFY_TOKEN=
# App Secret de la app de Meta: verifica la firma X-Hub-Signature-256 del webhook.
META_APP_SECRET=
# WA_CLOUD_API_VERSION=v21.0

# ── Comunes ──────────────────────────────────────────────────────────────────
BOT_API_KEY=
CORS_ORIGINS=
