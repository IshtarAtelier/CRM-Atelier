# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
wa-service/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Los dev servers en puertos paralelos crean .next-<nombre> (ver CLAUDE.md).
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example
bot-service/.env
wa-service/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/prisma/generated

# whatsapp
.wwebjs_auth/
.wwebjs_cache/

# database
dev.db*
prisma/dev.db*
prisma/atelier.db
backups/
# Reversas de scripts de mantenimiento (llevan IDs de clientes reales)
scripts/maintenance/reversa-*.json
/storage

# scratch files
/scratch/

# content data (already uploaded to DB)
/data/

# agent sessions (ephemeral state)
/.agents/
/next.log

# logs
/logs/

# prisma debug files
/prisma/_match_results.json
.playwright-browsers/
.claude/

# Ads (scripts/ads) — nunca commitear logs ni info de tokens
scripts/ads/meta_api.log
scripts/ads/token_info.json
scripts/ads/out/

# Piezas de redes: los JPEG SÍ se commitean (Instagram no acepta los bytes de la
# imagen: descarga la URL pública, así que tienen que estar deployados). Los PNG
# master son solo para archivo local y pesan de más.
public/social/**/*.png
