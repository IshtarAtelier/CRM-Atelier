# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
wa-service/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Los dev servers en puertos paralelos crean .next-<nombre> (ver CLAUDE.md).
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Regla amplia a propósito: cualquier .env, y también sus COPIAS. El 9/8/2026
# apareció un `.env.bak-pre-write-token` (backup hecho antes de rotar un token)
# que no matcheaba ninguna regla y quedaba listo para entrar con un `git add -A`,
# con todos los secretos reales adentro. Un backup del .env es tan secreto como
# el .env. La excepción explícita es el ejemplo, que no tiene valores.
.env*
!.env.example
bot-service/.env*
wa-service/.env*
!wa-service/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/prisma/generated

# whatsapp
.wwebjs_auth/
.wwebjs_cache/

# database
dev.db*
prisma/dev.db*
prisma/atelier.db
backups/
# Reversas de scripts de mantenimiento (llevan IDs de clientes reales)
scripts/maintenance/reversa-*.json
/storage

# scratch files
/scratch/

# content data (already uploaded to DB)
/data/

# agent sessions (ephemeral state)
/.agents/
/next.log

# logs
/logs/

# prisma debug files
/prisma/_match_results.json
.playwright-browsers/
.claude/

# Ads (scripts/ads) — nunca commitear logs ni info de tokens
scripts/ads/meta_api.log
scripts/ads/token_info.json
scripts/ads/out/

# Piezas de redes: los JPEG SÍ se commitean (Instagram no acepta los bytes de la
# imagen: descarga la URL pública, así que tienen que estar deployados). Los PNG
# master son solo para archivo local y pesan de más.
public/social/**/*.png

# Packaging: los PDF y PNG de las cajas se regeneran con el script
scripts/packaging/salida/

# Frames intermedios de los reels (se borran solos, pero por si un render se corta)
social/contenido/reels/salida/.frames-*/

# Vista previa generada por check:venta
scripts/checks/.confirmacion-compra.preview.html

# Logs y borradores: se generan solos, no van en git (la carpeta queda en disco).
logs/
scratch/
