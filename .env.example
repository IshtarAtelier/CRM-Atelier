# ===========================================
# Atelier Óptica CRM — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git!

# ===== Database =====
DATABASE_URL=postgresql://postgres:localpassword@localhost:5432/atelier
PROD_DATABASE_URL=  # Production DB URL (for scripts only)

# ===== Authentication =====
JWT_SECRET=  # REQUIRED: Generate with: openssl rand -hex 32
BOT_API_KEY=  # REQUIRED: API key for wa-service ↔ CRM communication

# ===== Cron Jobs =====
CRON_SECRET=  # REQUIRED: Secret for authenticating cron job requests

# ===== Email (Gmail SMTP) =====
EMAIL_USER=  # Gmail address for sending emails
EMAIL_PASS=  # Gmail App Password (not your regular password)
ADMIN_EMAIL=  # Admin email for notifications

# ===== Google Cloud / AI =====
GOOGLE_GENAI_API_KEY=  # Google Gemini API key
GOOGLE_CLOUD_PROJECT=  # GCP Project ID
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_VERTEX_AI_WEB_CREDENTIALS=  # Service Account JSON (or use GOOGLE_APPLICATION_CREDENTIALS)

# ===== Google Places (Reviews) =====
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=  # Google Place ID for the store (used in reviews page)

# ===== Payment Gateway (PayWay) =====
PAYWAY_SITE_ID=
PAYWAY_PUBLIC_KEY=
PAYWAY_PRIVATE_KEY=
PAYWAY_ENVIRONMENT=  # 'sandbox' or 'production'

# ===== Pasarela de respaldo (Mercado Pago — Checkout Pro) =====
# Nace apagada. MP_ENABLED=true la muestra en el checkout; se prende sin deploy.
# Ver docs/runbook-mercado-pago.md antes de tocar esto.
MP_ACCESS_TOKEN=     # Credencial privada (TEST-... en sandbox, APP_USR-... en producción)
MP_PUBLIC_KEY=       # Credencial pública (no se usa en Checkout Pro, se guarda por si se migra a Bricks)
MP_WEBHOOK_SECRET=   # "Clave secreta" del webhook, del panel de MP. Sin esto no se valida la firma.
MP_ENABLED=false     # 'true' para habilitar el pago con Mercado Pago en la tienda

# ===== Meta / WhatsApp =====
# META_ACCESS_TOKEN es el token de la API de Conversiones (los eventos
# server-side que manda src/services/ads.service.ts). Generarlo lleva 2 minutos:
#   business.facebook.com → Events Manager → elegir el píxel → pestaña
#   "Configuración" → sección "API de conversiones" → "Generar token de acceso".
# (Requiere ser admin del negocio.) Se pega acá y en las variables de Railway.
# Sin token la tienda funciona igual: el service loguea una vez y no manda nada.
# OJO: no es intercambiable con META_ADS_TOKEN (ese es de LECTURA de campañas
# y no puede escribir eventos; este no puede leer stats — ver getPixelHealth).
META_ACCESS_TOKEN=  # token del Conversions API (Events Manager → Configuración → Generar token)
META_PIXEL_ID=  # Meta Pixel ID for server-side tracking
NEXT_PUBLIC_META_PIXEL_ID=  # Meta Pixel ID for client-side tracking

# ===== Meta Marketing API (scripts/ads — ver scripts/ads/CLAUDE.md) =====
META_ADS_TOKEN=  # token de LECTURA (ads_read), usuario de sistema del BM
META_ADS_WRITE_TOKEN=  # token con ads_management; solo escrituras confirmadas
META_APP_ID=  # id de la app de developers.facebook.com (junto con el secret, arma el app token para debug_token)
META_APP_SECRET=  # app secret para appsecret_proof y app token (recomendado)
META_AD_ACCOUNT_ID=  # cuenta publicitaria, formato act_XXXXXXXXX
# META_ALLOW_WRITES=1  # pasar INLINE en el comando (no exportar) solo para una operación de escritura confirmada

# ===== Google Ads API (scripts/ads/lib/google_client.js — pendiente developer token) =====
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=  # solo si el acceso es a través de una cuenta administradora (MCC)
# GOOGLE_ADS_ALLOW_WRITES=1  # mismo criterio que META_ALLOW_WRITES: inline, nunca export

# --- Conversiones offline (la venta que se cierra por WhatsApp o en el local) ---
# Sin esto Google ve el clic del anuncio y nunca se entera de que terminó en
# venta: puja contra acciones blandas que valen todas lo mismo.
# 1. Crear la acción en Google Ads: Objetivos → Conversiones → Nueva →
#    "Importar" → "Conversiones sin conexión", con conversiones mejoradas
#    habilitadas (es lo que permite emparejar por mail/teléfono hasheados
#    cuando no hay gclid, o sea casi todo cierre por WhatsApp).
# 2. Pegar acá el id numérico de esa acción.
GOOGLE_ADS_OFFLINE_CONVERSION_ACTION=
# Segunda llave: el service queda inerte hasta que esto valga 1, para que la
# app nunca empiece a escribir en Google Ads sin que alguien lo decida.
# GOOGLE_ADS_UPLOAD_CONVERSIONS=1
# Ensayo: manda el lote con validateOnly, Google revisa el formato y no registra nada.
# GOOGLE_ADS_VALIDATE_ONLY=1

# ===== WhatsApp Service =====
WA_SERVER_URL=http://localhost:3001  # wa-service URL
WA_API_KEY=  # API key to protect wa-service endpoints
NEXT_PUBLIC_WA_URL=  # Public WhatsApp widget URL

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000  # Comma-separated allowed origins

# ===== Optional =====
FIREBASE_PROJECT_ID=  # For cloud file storage
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_PHONE=  # WhatsApp phone for storefront

# ===== Medición / Analítica =====
# GA4: si se setea, TrackingScripts carga Google Analytics (solo con consentimiento).
# La analítica PROPIA del sitio (tabla AnalyticsEvent + /admin/analitica) NO depende de esto.
NEXT_PUBLIC_GA_ID=  # ej: G-XXXXXXXXXX
NEXT_PUBLIC_APP_URL=https://atelieroptica.com.ar  # usado por el feed de Shopping y el CAPI web

# Conversión de COMPRA de Google Ads. Sin estas dos, la campaña ve visitas pero
# ninguna venta, y Shopping/PMax no pueden pujar por conversiones.
# Se sacan de Google Ads → Objetivos → Conversiones → (acción de compra) →
# "Configurar la etiqueta" → "Instalar la etiqueta manualmente": ahí aparece
# send_to: 'AW-123456789/AbC-D_efGh' — el ID es lo de antes de la barra y el
# label lo de después. El ID va también como NEXT_PUBLIC_GOOGLE_ADS_TAG_ID si
# se quiere cargar gtag.js aunque no haya conversión configurada todavía.
GOOGLE_ADS_CONVERSION_ID=  # ej: AW-123456789
GOOGLE_ADS_CONVERSION_LABEL=  # ej: AbC-D_efGh

# ===== Email (Resend) =====
# IMPORTANTE: sin EMAIL_FROM, los correos salen desde onboarding@resend.dev (dominio no propio).
EMAIL_FROM=Atelier Óptica <ventas@atelieroptica.com.ar>

# ===== Base de datos / escalabilidad =====
# En Railway con varias instancias (Next + wa-service + crons) conviene limitar el pool
# de Prisma por servicio para no agotar max_connections. Agregar a DATABASE_URL, ej:
#   ...&connection_limit=5&pool_timeout=20
# o usar un pooler (pgbouncer) con pgbouncer=true.
